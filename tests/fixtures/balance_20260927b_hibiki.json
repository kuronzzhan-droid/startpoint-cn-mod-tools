 "cas": {
  "desc_override_psychic_teleport_moon": [
   [
    "赋予自身特殊强化弹射\n强化自身冲刺\n自身冲刺间隔无法进一步缩短\n持有贯穿效果时，暗属性角色攻击力＋300%、强化弹射伤害＋200%\n暗属性共鸣时，贯穿效果持续时间＋30%；暗属性角色发动技能时，自身立即获得强化弹射效果\n每发动3次强化弹射（含额外触发），自身“回响”＋2层\n强化弹射每累计命中4次，自身攻击力＋50%\n冲刺时，立即获得强化弹射效果（冷却时间：1.5秒）"
   ]
  ],
  "desc_override_psychic_teleport_moon_3": [
   [
    " <icon id='main'>  暗属性共鸣时，每发动1次强化弹射，自身获得1层“回响”\n <icon id='main'>  自身对“回响”每提升1层，强化弹射伤害＋25%、攻击力＋25%\n <icon id='main'>  每1层“回响”，强化弹射伤害额外乘区＋5%（最多5层）"
   ]
  ],
  "desc_override_psychic_teleport_moon_4": [
   [
    "持有贯穿效果期间，自身攻击力＋200%\n持有贯穿效果期间，强化弹射伤害＋150%"
   ]
  ],
  "ability_skill_psychic_teleport_moon_pf_skill": [
   [
    "立即获得强化弹射效果"
   ]
  ],
  "ability_skill_psychic_teleport_moon_pf_dash": [
   [
    "立即获得强化弹射效果（冷却时间：1.5秒）"
   ]
  ]
 },
