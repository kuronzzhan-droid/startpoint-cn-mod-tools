 "cas": {
  "desc_override_kyle_moon": [
   [
    "赋予自身特殊强化弹射\n雷属性共鸣时：强化自身冲刺\n自身冲刺间隔无法进一步缩短\n雷属性共鸣时：自身“月牙”每上升1层，自身攻击力＋7.5%、直击伤害＋10%；除自身外雷属性角色攻击力＋1.25%、直击伤害＋7.5%\n雷属性共鸣时：自身“月牙”每上升1层，自身直击判定次数＋1（最多10层）\n雷属性共鸣时：自身每获得一次贯穿效果，雷属性角色攻击力＋2.5%、追击伤害＋0.5%\n雷属性共鸣时：雷属性角色技能槽最大值＋20%、技能充能速度＋20%"
   ]
  ],
  "desc_override_kyle_moon_2": [
   [
    " <icon id='main'>  雷属性共鸣时：自身“月牙”每提升1层，自身攻击力＋16%、雷属性角色直击伤害＋10%（最多10层）"
   ]
  ],
  "desc_override_kyle_moon_3": [
   [
    " <icon id='main'>  雷属性共鸣时：雷属性角色发动技能时，自身“月牙”＋1层；雷属性角色每造成100次直击，自身“月牙”＋1层\n <icon id='main'>  雷属性共鸣时：自身每获得一次贯穿效果，2秒后自身技能槽＋10%（冷却时间：10秒）\n <icon id='main'>  雷属性共鸣时：自身持有“月牙”时，强化雷属性角色的直接攻击为3次，合计伤害额外乘区＋300%"
   ]
  ],
  "desc_override_kyle_moon_6": [
   [
    "雷属性共鸣时：进一步强化技能「月华·狼牙连斩」的效果\n雷属性共鸣时：雷属性角色对处于“迟缓”状态的敌人造成伤害，额外乘区＋15%"
   ]
  ],
  "desc_override_kyle_moon_1": [
   [
    " <icon id='main'>  战斗开始时：雷属性角色技能槽＋50%\n <icon id='main'>  雷属性共鸣时：自身技能槽＋50%，并进一步强化技能「月华·狼牙连斩」的效果"
   ]
  ],
  "change_skill_kyle_moon": [
   [
    "进一步强化技能「月华·狼牙连斩」的效果"
   ]
  ]
 },
