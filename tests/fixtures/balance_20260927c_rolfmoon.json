 "cas": {
  "desc_override_black_wolf_knight_moon": [
   [
    "风属性共鸣时：全体增益效果的持续时间＋100%（包括贯穿、最大速度固定）\n风属性共鸣时：强化自身冲刺，冲刺冷却时间－33%\n风属性共鸣时：冲刺间隔缩短效果不会让自身的冲刺冷却时间进一步缩短\n风属性共鸣时：自身发动技能时，技能所赋予的最大速度固定效果强化至4档，且不衰减技能槽能量获取\n风属性共鸣时：风属性角色每造成100次直接攻击，风属性角色攻击力＋20%、直击伤害＋20%，直击伤害额外乘区＋2%\n最大速度固定效果持续期间，每持续1秒，自身攻击力＋5%、直击伤害＋5%\n风属性共鸣时：战斗开始时，风属性角色技能槽＋50%、技能槽最大值＋10%"
   ]
  ],
  "desc_override_black_wolf_knight_moon_4": [
   [
    "风属性共鸣时：自身技能槽＋50%\n风属性共鸣时：赋予风属性角色技能充能速度＋10%"
   ]
  ],
  "change_skill_black_wolf_knight_moon": [
   [
    "风属性共鸣时强化技能：威力随连击数提升（按直接攻击伤害判定）"
   ]
  ],
  "change_skill_black_wolf_knight_moon_2": [
   [
    "担任队长并达成风属性共鸣时强化技能：把赋予的最大速度固定强化到最高档、不衰减技能槽能量获取"
   ]
  ],
  "desc_override_black_wolf_knight_moon_3": [
   [
    " <icon id='main'>  风属性共鸣时：风属性角色的直接攻击强化为3次（同类效果不叠加，取最大值），合计伤害额外乘区＋200%\n <icon id='main'>  自身处于最大速度固定状态时：自身攻击力＋100%、直击伤害＋100%\n <icon id='main'>  风属性共鸣时：强化技能，威力随连击数提升（按直接攻击伤害判定），每达成100连击 → 立即对最近的敌人发动自身技能的攻击效果（不消耗技能槽，冷却时间：5秒）\n <icon id='main'>  风属性共鸣时：每达成100连击，连击数＋50"
   ]
  ]
 }
