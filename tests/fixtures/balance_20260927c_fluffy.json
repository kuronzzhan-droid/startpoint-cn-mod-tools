 "cas": {
  "desc_override_combat_animal_moon": [
   [
    "风属性共鸣时，自身的强化弹射同时具备辅助与格斗两种类型\n风属性共鸣时，战斗开始时风属性角色技能槽最大值＋20%、技能充能速度＋20%、技能槽＋50%\n风属性共鸣时，每发动3次强化弹射，风属性角色技能充能速度＋5%、技能槽最大值＋5%、技能伤害额外乘区＋1%\n风属性共鸣时，每发动1次强化弹射，风属性角色攻击力＋2%、技能伤害＋2%、连击＋5\n风属性共鸣时，每发动5次强化弹射Lv3时，连击＋500，并触发自身技能效果（不消耗技能槽，冷却时间：6秒）\n风属性共鸣时，每达到250连击，自身技能伤害＋20%\n风属性共鸣时，冲刺间隔缩短效果不会让自身的冲刺冷却时间进一步缩短"
   ]
  ],
  "ability_skill_combat_animal_moon": [
   [
    "触发『玉杵捣月·桂风连打』的技能效果（不消耗技能槽）"
   ]
  ],
  "desc_override_combat_animal_moon_3": [
   [
    " <icon id='main'>  风属性共鸣时，连击达到50以上时，自身技能伤害＋200%\n <icon id='main'>  风属性共鸣时，发动强化弹射时，连击＋10\n <icon id='main'>  风属性共鸣时，每达成150连击，触发自身技能效果（不消耗技能槽，冷却时间：12秒）\n <icon id='main'>  风属性共鸣时，自身对敌人的技能伤害额外乘区＋10%\n <icon id='main'>  风属性共鸣时，强化『玉杵捣月·桂风连打』的连击效果，技能命中每次连击＋55\n <icon id='main'>  风属性共鸣时，自身技能的最后一击结束后，连击数归零"
   ]
  ],
  "change_skill_2_combat_animal_moon": [
   [
    "强化『玉杵捣月·桂风连打』的连击效果，技能命中时追加连击"
   ]
  ]
 },
