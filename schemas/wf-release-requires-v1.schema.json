{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startpoint-cn.local/schemas/wf-release-requires-v1.schema.json",
  "title": "World Flipper release requirements v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"
    },
    "dottedVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))+$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "runtimeApi",
    "serverCapabilities",
    "clientVersions",
    "resourceBaselines",
    "contentDigests",
    "patchOverlaySchema",
    "clientPatchProfile"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runtimeApi": {
      "type": "integer",
      "minimum": 1
    },
    "serverCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "clientVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dottedVersion"}
    },
    "resourceBaselines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dottedVersion"}
    },
    "contentDigests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/releaseId"}
    },
    "patchOverlaySchema": {
      "type": "integer",
      "minimum": 1
    },
    "clientPatchProfile": {
      "type": "boolean"
    }
  }
}
