{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startpoint-cn.local/schemas/studio-draft.schema.json",
  "title": "编辑台草稿（studio draft）changeset v1",
  "description": "work/studio-drafts/<角色ID>/changeset.json 的结构，以及写入 API / CLI 接受的请求体。草稿只记录「换成什么」，不写任何游戏表、store、补丁链或服务器；生成补丁由 wf deliver 负责。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "characterId", "code", "baseView", "createdAt", "updatedAt", "savedAt", "revision", "savedRevision", "changes"],
  "properties": {
    "schema": {"const": "wf-studio-draft/1"},
    "subjectKind": {"enum": ["character", "boss"], "description": "旧角色草稿可省略；boss 使用独立草稿目录，characterId 为兼容容器中的副本 ID"},
    "characterId": {"type": "string"},
    "code": {"$ref": "#/$defs/code"},
    "baseView": {"type": "string", "pattern": "^1\\.4\\.[0-9]+$", "description": "草稿基于的视图资源版本"},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "updatedAt": {"$ref": "#/$defs/timestamp"},
    "savedAt": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}],
                "description": "最近一次「保存」动作（整体校验 + 文件哈希复核）通过的时间；之后又有改动则早于 updatedAt"},
    "revision": {"type": "integer", "minimum": 0, "description": "每次增删改动 +1"},
    "savedRevision": {"type": ["integer", "null"], "minimum": 0,
                      "description": "最近一次「保存」通过时的 revision；等于 revision 才算已保存"},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}}
  },
  "allOf": [{
    "if": {"required": ["subjectKind"], "properties": {"subjectKind": {"const": "boss"}}},
    "then": {"properties": {"characterId": {"$ref": "#/$defs/bossId"}}},
    "else": {"properties": {"characterId": {"$ref": "#/$defs/characterId"}}}
  }],
  "$defs": {
    "bossParameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "level": {"type": "integer", "minimum": 1, "maximum": 999},
        "hpMultiplier": {"type": "number", "exclusiveMinimum": 0, "maximum": 2147483647},
        "attackMultiplier": {"type": "number", "exclusiveMinimum": 0, "maximum": 2147483647},
        "restrictedElement": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
        "recommendedElement": {"type": "integer", "minimum": 0, "maximum": 5},
        "bgm": {"type": "string", "minLength": 1},
        "scene": {"type": "string", "minLength": 1}
      }
    },
    "bossRequest": {
      "type": "object", "additionalProperties": false, "required": ["operation"],
      "properties": {
        "operation": {"enum": ["edit", "create_shared"]},
        "sourceQuest": {"type": "string", "pattern": "^(?:(?:boss_battle|hard_multi|practice):)?[0-9]+(?:/[0-9]+)*$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "parameters": {"$ref": "#/$defs/bossParameters"},
        "tiers": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/bossParameters"}},
        "ids": {"type": "object", "additionalProperties": false, "required": ["event"],
          "properties": {"event": {"type": "string", "pattern": "^[2-9][0-9]{3}$"},
                         "node": {"type": "string", "pattern": "^[1-9][0-9]*$"}}}
      },
      "allOf": [
        {"if": {"properties": {"operation": {"const": "edit"}}},
         "then": {"not": {"anyOf": [{"required": ["ids"]}, {"required": ["sourceQuest"]}, {"required": ["name"]}]}}},
        {"if": {"properties": {"operation": {"const": "create_shared"}}},
         "then": {"not": {"required": ["tiers"]}}}
      ]
    },
    "bossId": {"type": "string", "pattern": "^(?:[0-9]{1,9}|boss_battle:[0-9]{1,9}(?:/[0-9]{1,9}/[0-9]{1,9})?|hard_multi:[0-9]{1,9}(?:/[0-9]{1,9})?|practice:[0-9]{1,9})$"},
    "characterId": {"type": "string", "pattern": "^[0-9]{1,9}$"},
    "code": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logicalPath": {
      "type": "string",
      "pattern": "^(character|battle)/[a-z0-9_]+(/[A-Za-z0-9_.\\-]+)+$",
      "description": "游戏逻辑路径（未哈希），只允许 character/ 与 battle/ 下"
    },
    "draftPath": {
      "type": "string",
      "pattern": "^(files|sources)/[A-Za-z0-9_./\\-]+$",
      "description": "相对草稿目录的路径；不允许 .. 与绝对路径（由实现另行检查）"
    },
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "unitPoint": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2},
    "rgb": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}, "minItems": 3, "maxItems": 3},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "code", "message"],
      "properties": {
        "level": {"enum": ["error", "warn", "info"]},
        "code": {"type": "string", "pattern": "^[a-z0-9_.\\-]+$"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "draftFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical", "root", "draft", "sha256", "size", "encoding", "base", "approximate"],
      "properties": {
        "logical": {"$ref": "#/$defs/logicalPath"},
        "root": {"enum": ["common", "medium", "android"], "description": "CDN 根：common=upload / medium=medium_upload / android=android_upload"},
        "draft": {"$ref": "#/$defs/draftPath"},
        "sha256": {"$ref": "#/$defs/sha256", "description": "草稿文件（标准格式）的 SHA-256"},
        "size": {"type": "integer", "minimum": 1},
        "encoding": {
          "enum": ["png", "mp3", "atf-deflate"],
          "description": "png/mp3 为标准格式，交付时由 wf_assets.png_encode / mp3_encode 转成存储态；atf-deflate 已是游戏字节"
        },
        "storeSha256": {"$ref": "#/$defs/sha256", "description": "按存储态编码后的 SHA-256（png/mp3 才有）"},
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "layer"],
          "properties": {
            "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}], "description": "被替换的视图字节（存储态）的 SHA-256；新文件为 null"},
            "layer": {"type": ["string", "null"], "description": "视图里来自 store131 还是哪条补丁边"}
          }
        },
        "approximate": {"type": "boolean", "description": "true = 派生规则是近似（未与官方构图逐像素核对）"},
        "note": {"type": "string"}
      }
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical", "reason"],
      "properties": {
        "logical": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "value": {"description": "交付时要写入的值（例如表行），只是意图，草稿不写表"}
      }
    },
    "iconGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "factor"],
      "properties": {
        "anchor": {"$ref": "#/$defs/unitPoint", "description": "脸锚在裁剪框里的相对位置 (fx, fy)"},
        "factor": {"type": "number", "exclusiveMinimum": 0, "maximum": 20, "description": "裁剪框高度 = squareHeight × factor"}
      }
    },
    "cropTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["face", "squareHeight", "groups", "cutin", "backdrop"],
      "description": "立绘派生裁剪模板。所有坐标都在去掉全透明边后的立绘（即 full_shot PNG）像素坐标系里。",
      "properties": {
        "face": {"$ref": "#/$defs/point", "description": "脸锚 = 两眼连线中点（与 full_shot_image_attribute 的 faceX/faceY 同语义）"},
        "squareHeight": {"type": "number", "exclusiveMinimum": 0},
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["square", "thumb_level_up", "battle_member_status", "battle_control_board", "cutin_skill_chain", "thumb_party_main"],
          "properties": {
            "square": {"$ref": "#/$defs/iconGroup"},
            "thumb_level_up": {"$ref": "#/$defs/iconGroup"},
            "battle_member_status": {"$ref": "#/$defs/iconGroup"},
            "battle_control_board": {"$ref": "#/$defs/iconGroup"},
            "cutin_skill_chain": {"$ref": "#/$defs/iconGroup"},
            "thumb_party_main": {"$ref": "#/$defs/iconGroup"}
          }
        },
        "cutin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["center", "height", "anchor"],
          "properties": {
            "center": {"$ref": "#/$defs/point"},
            "height": {"type": "number", "exclusiveMinimum": 0},
            "anchor": {"$ref": "#/$defs/unitPoint"}
          }
        },
        "backdrop": {
          "anyOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["inner", "outer"],
             "properties": {"inner": {"$ref": "#/$defs/rgb"}, "outer": {"$ref": "#/$defs/rgb"}}}
          ],
          "description": "图标底色（径向渐变）；null = 透明底（官方图标多为带底，透明底会被门禁判占比过低）"
        }
      }
    },
    "portraitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "template"],
      "properties": {
        "form": {"enum": ["0", "1"]},
        "source": {"enum": ["upload", "current"], "default": "upload",
                   "description": "upload = 先用 portrait/<form>/source 上传的新立绘；current = 只用当前视图里的立绘重新裁剪"},
        "template": {"$ref": "#/$defs/cropTemplate"},
        "atf": {"type": "boolean", "default": true, "description": "是否用 wf_atf 重编 skill_cutin 的 ATF"}
      }
    },
    "pixelFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "anchor"],
      "properties": {
        "png": {"type": "string", "description": "base64 PNG（API 请求里用）"},
        "file": {"$ref": "#/$defs/draftPath", "description": "草稿内的帧文件（changeset 里用）"},
        "sha256": {"$ref": "#/$defs/sha256", "description": "帧文件 SHA-256（changeset 里用）"},
        "duration": {"type": "integer", "minimum": 1, "maximum": 600, "description": "停留帧数（60fps）"},
        "anchor": {"$ref": "#/$defs/point", "description": "帧图内的定位原点（脚底中心），像素坐标"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "pixelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "action", "frames"],
      "properties": {
        "family": {"enum": ["pixelart", "special"]},
        "action": {"type": "string", "pattern": "^[a-z_]+$"},
        "frames": {"type": "array", "minItems": 1, "maxItems": 240, "items": {"$ref": "#/$defs/pixelFrame"}},
        "dryRun": {"type": "boolean", "default": false},
        "origin": {"type": "object", "description": "来源说明，例如 {\"mode\":\"sheet\",\"columns\":4,\"rows\":2}"}
      }
    },
    "voiceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice", "audio", "filename"],
      "properties": {
        "voice": {"type": "string", "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)+$", "description": "相对 character/<code>/voice/ 的路径，不带 .mp3，例如 home/home_0、battle/skill_0"},
        "audio": {"type": "string", "description": "base64 WAV / MP3 / 其它 ffmpeg 能读的音频"},
        "filename": {"type": "string", "minLength": 1},
        "loudness": {"type": "number", "minimum": -30, "maximum": -6, "description": "目标积分响度 LUFS；默认按语音类别取官方中位"}
      }
    },
    "abilityCell": {
      "type": "object", "additionalProperties": false, "required": ["column", "old", "new"],
      "properties": {
        "column": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "pattern": "^c[0-9]+$"}]},
        "old": {"type": ["string", "null"]}, "new": {"type": ["string", "null"]}
      }
    },
    "abilityCells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/abilityCell"}},
    "abilityNewRows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/abilityCells"}},
    "abilityOperation": {
      "type": "object", "additionalProperties": false, "required": ["op", "table", "key"],
      "properties": {
        "op": {"enum": ["set_cells", "insert_row", "delete_row", "move_row", "attach_key"]},
        "table": {"enum": ["ability", "leader_ability", "action_skill"]},
        "key": {"type": "string", "minLength": 1}, "character": {"$ref": "#/$defs/characterId"},
        "level": {"enum": ["1", "2", "3"]},
        "row": {"type": "integer", "minimum": 0}, "row_count": {"type": "integer", "minimum": 1},
        "to_row": {"type": "integer", "minimum": 0},
        "column_space": {"enum": ["ability", "native"]}, "cells": {"$ref": "#/$defs/abilityCells"},
        "shared_ok": {"type": "boolean"}, "group": {"type": "string"}, "note": {"type": "string"},
        "slot": {"type": "integer", "minimum": 0, "maximum": 6}, "old_key": {"type": "string"},
        "rows": {"$ref": "#/$defs/abilityNewRows"},
        "levels": {"type": "object", "minProperties": 1, "propertyNames": {"enum": ["1", "2", "3"]},
                   "additionalProperties": {"$ref": "#/$defs/abilityNewRows"}}
      },
      "allOf": [
        {"if": {"properties": {"op": {"const": "attach_key"}}},
         "then": {"required": ["slot", "old_key"], "not": {"anyOf": [{"required": ["row"]}, {"required": ["row_count"]}, {"required": ["cells"]}, {"required": ["level"]}, {"required": ["to_row"]}]}},
         "else": {"required": ["row", "row_count", "cells"], "not": {"anyOf": [{"required": ["slot"]}, {"required": ["old_key"]}, {"required": ["rows"]}, {"required": ["levels"]}]}}},
        {"if": {"properties": {"op": {"const": "move_row"}}}, "then": {"required": ["to_row"]}, "else": {"not": {"required": ["to_row"]}}},
        {"if": {"properties": {"op": {"enum": ["set_cells", "move_row"]}}},
         "then": {"properties": {"cells": {"items": {"properties": {"old": {"type": "string"}, "new": {"type": "string"}}}}}}},
        {"if": {"properties": {"op": {"const": "insert_row"}}},
         "then": {"properties": {"cells": {"items": {"properties": {"old": {"type": "null"}, "new": {"type": "string"}}}}}}},
        {"if": {"properties": {"op": {"const": "delete_row"}}},
         "then": {"properties": {"cells": {"items": {"properties": {"old": {"type": "string"}, "new": {"type": "null"}}}}}}},
        {"if": {"properties": {"table": {"const": "action_skill"}, "op": {"enum": ["set_cells", "insert_row", "delete_row", "move_row"]}}},
         "then": {"required": ["level"]}, "else": {"not": {"required": ["level"]}}}
      ]
    },
    "abilityTextPair": {
      "type": "object", "additionalProperties": false, "required": ["old", "new"],
      "properties": {"old": {"type": "string"}, "new": {"type": "string"}}
    },
    "abilityText": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "action_skill": {"type": "object", "minProperties": 1, "propertyNames": {"enum": ["1", "2", "3"]},
          "additionalProperties": {"type": "object", "minProperties": 1, "propertyNames": {"enum": ["c0", "c1"]},
                                   "additionalProperties": {"$ref": "#/$defs/abilityTextPair"}}},
        "character_text": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[0-9]+$"},
                           "additionalProperties": {"$ref": "#/$defs/abilityTextPair"}},
        "custom_ability_string": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/abilityTextPair"}},
        "desc_override": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/abilityTextPair"}}
      }
    },
    "abilityRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "operations": {"type": "array", "items": {"$ref": "#/$defs/abilityOperation"}},
        "text": {"$ref": "#/$defs/abilityText"}, "shared_ok": {"type": "boolean"}
      },
      "anyOf": [{"required": ["operations"], "properties": {"operations": {"minItems": 1}}}, {"required": ["text"]}]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "createdAt", "target", "params", "files", "pending", "checks"],
      "properties": {
        "id": {"type": "string", "pattern": "^c-[0-9a-f]{12}$"},
        "kind": {"enum": ["portrait", "pixel_action", "voice_line", "ability_edit", "boss"]},
        "title": {"type": "string", "minLength": 1},
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "target": {"type": "object"},
        "params": {"type": "object"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/draftFile"}},
        "pending": {"type": "array", "items": {"$ref": "#/$defs/pending"}},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "boss"}}},
          "then": {"properties": {
            "target": {"type": "object", "additionalProperties": false, "required": ["quest"],
                       "properties": {"quest": {"$ref": "#/$defs/bossId"}}},
            "params": {"type": "object", "additionalProperties": false, "required": ["requests", "inputs"],
              "properties": {
                "requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bossRequest"}},
                "inputs": {"type": "object", "additionalProperties": false, "required": ["client", "server"],
                  "properties": {
                    "client": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
                    "server": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
                  }}
              }},
            "files": {"maxItems": 0}, "pending": {"maxItems": 0}
          }}
        },
        {
          "if": {"properties": {"kind": {"const": "ability_edit"}}},
          "then": {
            "properties": {
              "target": {"type": "object", "additionalProperties": false, "required": ["character"],
                         "properties": {"character": {"$ref": "#/$defs/characterId"}}},
              "params": {"type": "object", "additionalProperties": false, "required": ["requests", "inputSha256"],
                         "properties": {
                           "requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/abilityRequest"}},
                           "inputSha256": {"type": "object", "minProperties": 1,
                                           "additionalProperties": {"$ref": "#/$defs/sha256"}}
                         }},
              "files": {"maxItems": 0}, "pending": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "portrait"}}},
          "then": {
            "properties": {
              "target": {"type": "object", "additionalProperties": false, "required": ["form"],
                         "properties": {"form": {"enum": ["0", "1"]}}},
              "params": {"type": "object", "additionalProperties": false,
                         "required": ["source", "template", "sourceSize", "trim", "tableRows"],
                         "properties": {
                           "source": {"enum": ["upload", "current"]},
                           "template": {"$ref": "#/$defs/cropTemplate"},
                           "sourceSize": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
                           "trim": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
                           "tableRows": {"type": "object"},
                           "tableBefore": {"type": "object", "additionalProperties": false,
                             "patternProperties": {"^(character_image|trimmed_image|full_shot_image_attribute)$": {
                               "type": "object", "additionalProperties": false, "required": ["value", "sha256"],
                               "properties": {"value": {"type": ["string", "null"]},
                                              "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}
                             }}},
                           "sourceFile": {"$ref": "#/$defs/draftPath"},
                           "atf": {"type": "boolean"}
                         }}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "pixel_action"}}},
          "then": {
            "properties": {
              "target": {"type": "object", "additionalProperties": false, "required": ["family", "action"],
                         "properties": {"family": {"enum": ["pixelart", "special"]}, "action": {"type": "string"}}},
              "params": {"type": "object", "additionalProperties": false,
                         "required": ["frames", "totalFrames", "originalTotalFrames", "budget"],
                         "properties": {
                           "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pixelFrame"}},
                           "totalFrames": {"type": "integer", "minimum": 1},
                           "originalTotalFrames": {"type": ["integer", "null"]},
                           "budget": {"type": "object"},
                           "origin": {"type": "object"}
                         }}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "voice_line"}}},
          "then": {
            "properties": {
              "target": {"type": "object", "additionalProperties": false, "required": ["voice"],
                         "properties": {"voice": {"type": "string"}}},
              "params": {"type": "object", "additionalProperties": false,
                         "required": ["sourceName", "loudness", "durationSeconds", "format"],
                         "properties": {
                           "sourceName": {"type": "string"},
                           "sourceFile": {"$ref": "#/$defs/draftPath"},
                           "loudness": {"type": "number"},
                           "durationSeconds": {"type": "number", "minimum": 0},
                           "originalDurationSeconds": {"type": ["number", "null"]},
                           "format": {"type": "object"},
                           "subtitle": {"type": "string"}
                         }}
            }
          }
        }
      ]
    }
  }
}
