{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startpoint-cn.local/schemas/wf-release-v1.schema.json",
  "title": "World Flipper release manifest v1",
  "$comment": "Structural preflight only. The wf_release_v1 strict parser and verifier are authoritative for strict Python integer types, UTF-8 byte ordering, NFC paths, property-level uniqueness, component/file closure, releaseId verification, and self-replacement. Installers and receivers MUST NOT rely on this schema alone.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "dottedVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))+(?![\\s\\S])"
    },
    "payloadPath": {
      "type": "string",
      "pattern": "^(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))(?:content|server|modes)/[^/]+(?:/[^/]+)*(?![\\s\\S])"
    },
    "assetLogicalPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/]+(?:/[^/]+)*(?![\\s\\S])"
    },
    "assetReplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "logicalPath", "beforeSha256", "beforeSize"],
      "properties": {
        "root": {
          "oneOf": [
            {"const": "android"},
            {"const": "common"},
            {"const": "medium"}
          ]
        },
        "logicalPath": {"$ref": "#/$defs/assetLogicalPath"},
        "beforeSha256": {"$ref": "#/$defs/sha256"},
        "beforeSize": {"type": "integer", "minimum": 0}
      }
    },
    "component": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "root"],
          "properties": {
            "kind": {"const": "content"},
            "root": {"const": "content"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "root"],
          "properties": {
            "kind": {"const": "modes"},
            "root": {"const": "modes"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "root"],
          "properties": {
            "kind": {"const": "server"},
            "root": {"const": "server"}
          }
        }
      ]
    },
    "nullableDigest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/releaseId"}
      ]
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "version",
    "producer",
    "replaces",
    "sourceEvidence",
    "components",
    "expectedState",
    "metadataSha256",
    "files",
    "releaseId"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "replaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/releaseId"}
    },
    "sourceEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "workspaceInputSha256"],
          "properties": {
            "kind": {"const": "character-workspace-v1"},
            "workspaceInputSha256": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "workspaceInputSha256", "acceptedAssetReplacements"],
          "properties": {
            "kind": {"const": "character-workspace-v2"},
            "workspaceInputSha256": {"$ref": "#/$defs/sha256"},
            "acceptedAssetReplacements": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/assetReplacement"}
            }
          }
        }
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/component"}
    },
    "expectedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cdnTargetVersion", "contentDigest", "modeDigest"],
      "properties": {
        "cdnTargetVersion": {"$ref": "#/$defs/dottedVersion"},
        "contentDigest": {"$ref": "#/$defs/nullableDigest"},
        "modeDigest": {"$ref": "#/$defs/nullableDigest"}
      }
    },
    "metadataSha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires", "ownership"],
      "properties": {
        "requires": {"$ref": "#/$defs/sha256"},
        "ownership": {"$ref": "#/$defs/sha256"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/payloadPath"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "releaseId": {"$ref": "#/$defs/releaseId"}
  }
}
