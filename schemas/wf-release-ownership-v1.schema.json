{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startpoint-cn.local/schemas/wf-release-ownership-v1.schema.json",
  "title": "World Flipper release ownership v1",
  "$comment": "Structural preflight only. The wf_release_v1 strict parser is authoritative for strict Python integer types, UTF-8 byte ordering, and NFC paths. Installers and receivers MUST NOT rely on this schema alone.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "ownershipKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*:[^\\s:]+(?![\\s\\S])"
    },
    "logicalPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|(?![\\s\\S])))[^/]+(?:/[^/]+)*(?![\\s\\S])"
    }
  },
  "required": ["schemaVersion", "entities", "records", "paths"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ownershipKey"}
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ownershipKey"}
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/logicalPath"}
    }
  }
}
