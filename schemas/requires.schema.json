{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wf:requires:1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "pack": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "tail": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "anchor": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "archives": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "minItems": 1
        }
      },
      "required": [
        "since",
        "tail",
        "anchor",
        "archives"
      ],
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "properties": {
        "clientCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "clientPatches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "serverFeatures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "serverRestart": {
          "type": "boolean"
        },
        "restartReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minServerVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilityResolution": {
          "enum": [
            "pending-m2",
            "declared"
          ]
        }
      },
      "required": [
        "clientCapabilities",
        "clientPatches",
        "serverFeatures",
        "serverRestart",
        "restartReasons",
        "minServerVersion",
        "capabilityResolution"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "pack",
    "requires"
  ],
  "additionalProperties": false
}
